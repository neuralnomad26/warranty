# Never commit real values. `.env` is written by `stripe projects env --pull`; the rest go in `.env.local`.

# --- written by Stripe Projects (Supabase Postgres, used for the call log and replay protection)
SUPABASE_POOLER_URL=
SUPABASE_DB_PASS=

# --- you create these (see README "Run it yourself")
MPP_SECRET_KEY=            # openssl rand -hex 32   (signs 402 challenges)
MPP_TESTNET=true           # false = Tempo mainnet, real money
MPP_REALM=                 # production hostname, e.g. warranty-mpp.vercel.app (leave empty locally)
PUBLIC_ORIGIN=             # https://<production hostname> (leave empty locally)

WARRANTY_ADDRESS=          # pool wallet: receives payments, pays services, pays refunds, signs certificates
WARRANTY_PRIVATE_KEY=      # its private key. Testnet only until this has had a security review.
FLAKY_ADDRESS=             # separate wallet that receives payments for the demo service
DEMO_AGENT_ADDRESS=        # funded wallet behind the "Run the demo" buttons
DEMO_AGENT_PRIVATE_KEY=
